{
  "name": "foldertree",
  "version": "1.5.0",
  "description": "文件夹树查看器 — 把文件夹路径放进去，自动生成漂亮清晰的目录树",
  "main": "main.js",
  "author": "林宇锋 (lyfnb6666)",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.linyufeng.foldertree",
    "productName": "FolderTree",
    "files": ["main.js", "preload.js", "renderer/**/*", "package.json"],
    "directories": {
      "output": "dist"
    },
    "win": { "target": "nsis", "icon": "renderer/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FolderTree"
    },
    "mac": { "target": "dmg", "icon": "renderer/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "icon": "renderer/icon.png" }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
